# Database — SQLite for development:
DATABASE_URL=sqlite+aiosqlite:///./srp.db
# PostgreSQL for production:
# DATABASE_URL=postgresql+asyncpg://srp:srp_pass@localhost:5432/srp

SECRET_KEY=change-me-in-production-min-32-chars-long
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256
DEBUG=true

# Ollama (локальная LLM, обязательна для генерации)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
GENERATION_TIMEOUT=120

# RAG (ChromaDB)
CHROMA_PERSIST_DIRECTORY=./chroma_db
RAG_MAX_CHUNKS=8

# Web Search (DuckDuckGo — бесплатно, без API-ключа)
WEB_SEARCH_ENABLED=true
WEB_SEARCH_PROVIDER=duckduckgo
# Альтернативные провайдеры (опционально):
# WEB_SEARCH_PROVIDER=tavily
# TAVILY_API_KEY=
# WEB_SEARCH_PROVIDER=serpapi
# SERPAPI_API_KEY=

# SMTP (оставьте пустым/localhost для ConsoleEmailService)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_FROM_EMAIL=noreply@srp.dev

# Cookie settings
COOKIE_SECURE=false  # true в production с HTTPS
