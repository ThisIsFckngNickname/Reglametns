# --- SRP Backend Configuration ---

# Groq API (обязательно для работы с Groq)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama (локальный, для Stage 2)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# YandexGPT (опционально, для Stage 2)
YANDEXGPT_API_KEY=
YANDEXGPT_FOLDER_ID=

# Таймаут для запросов к провайдерам (секунды)
PROVIDER_TIMEOUT=60

# URL базы данных (SQLite по умолчанию)
DATABASE_URL=sqlite:///./data/srp.db
