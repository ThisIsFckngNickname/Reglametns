# Database — SQLite for development:
DATABASE_URL=sqlite+aiosqlite:///./srp.db
# PostgreSQL for production:
# DATABASE_URL=postgresql+asyncpg://srp:srp_pass@localhost:5432/srp
SECRET_KEY=change-me-in-production-min-32-chars-long
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256
DEBUG=true

# GigaChat (опционально — оставьте пустым для mock-режима генератора)
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
GIGACHAT_MODEL=GigaChat-Pro
GENERATION_TIMEOUT=120

# SMTP (оставьте пустым/localhost для ConsoleEmailService)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_FROM_EMAIL=noreply@srp.dev

# Cookie settings
COOKIE_SECURE=false  # true в production с HTTPS
